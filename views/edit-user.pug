extends layout

block content
  h1 Редактирование пользователя

  if error
    p.error= error

  form.form(method="POST", action=`/users/${user.id}`)
    label(for="name") Имя
    input#name(type="text", name="name", value=user.name, required)

    label(for="email") Email
    input#email(type="email", name="email", value=user.email, required)

    button.button(type="submit") Сохранить

  nav.nav
    a(href="/users") Вернуться к списку
